# GymVision AI - Frontend environment template
#
# Copy to .env.local and fill in. Never commit .env.local.
#
# Only values that are safe in a browser bundle belong here. Vite inlines every
# VITE_ variable into the shipped JavaScript, so no secret may appear.
# docs/09_security/47_SECURITY_ARCHITECTURE.md section 11 keeps secrets on the
# backend; the Google client ID is public by design, the client secret is not.

# Google OAuth client ID (public). Without it the sign-in page says so.
VITE_GOOGLE_CLIENT_ID=

# API base path. The dev server proxies /api to the backend, so the default
# works locally and in a single-origin deployment.
VITE_API_BASE_URL=/api/v1

# Backend the dev server proxies to.
VITE_API_PROXY_TARGET=http://127.0.0.1:8000

# --- Pose tracking ---------------------------------------------------------
# Leave both blank. The defaults are correct.
#
# The MediaPipe runtime is served from this app at /mediapipe/wasm, copied out
# of the installed package by scripts/sync-mediapipe.mjs so its version can
# never drift from the JavaScript that loads it.
VITE_MEDIAPIPE_WASM_URL=
#
# The pose model is about 6 MB, so it is fetched from Google's model storage
# and cached by the browser. Point this at your own copy for offline use.
VITE_POSE_MODEL_URL=
